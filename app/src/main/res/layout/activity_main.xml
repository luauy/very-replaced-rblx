<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E1E1E1">

    <!-- ========================================== -->
    <!-- 1. THE CLASSIC MID-YEARS ROBLOX BLUE BAR   -->
    <!-- ========================================== -->
    <RelativeLayout
        android:id="@+id/header_blue_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#19478A"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <!-- Vintage ROBLOX Block Text Logo -->
        <TextView
            android:id="@+id/roblox_logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="ROBLOX"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp" />

        <!-- Red Offline Status Pill -->
        <TextView
            android:id="@+id/status_offline_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/roblox_logo_text"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:background="#A20000"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="OFFLINE SANDBOX"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Dynamic Connection Alert (Container for Icon + Text) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Actual SDK Native Warning Icon -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="4dp"
                android:src="@android:drawable/stat_sys_warning" />

            <TextView
                android:id="@+id/connection_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Missing"
                android:textColor="#FFCC00"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ========================================== -->
    <!-- 2. DARK CHARCOAL SUB-NAVIGATION BAR        -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/sub_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="#333333"
        android:orientation="horizontal"
        android:paddingLeft="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Develop &amp; Run Local Projects"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========================================== -->
    <!-- 3. MAIN INTERFACE CONTENT CONTAINER        -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/instruction_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a local target file to execute:"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="6dp">

            <ListView
                android:id="@+id/offline_file_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#E1E1E1"
                android:dividerHeight="1dp"
                android:scrollbars="vertical" />
                
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
