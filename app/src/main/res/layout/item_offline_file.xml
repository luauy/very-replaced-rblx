<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Document/File Icon placeholder asset text -->
    <TextView
        android:id="@+id/file_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:text="doccy doc doc"
        android:textSize="24sp"
        android:layout_marginRight="12dp"/>

    <!-- File Name Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/file_icon"
        android:layout_toLeftOf="@+id/btn_load_file"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="placey place place"
            android:textColor="@color/roblox_text_dark"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Classic Emerald/Green Action Button -->
    <Button
        android:id="@+id/btn_load_file"
        android:layout_width="80dp"
        android:layout_height="36dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="@color/roblox_button_green"
        android:text="loady load load"
        android:textColor="@color/roblox_text_light"
        android:textSize="12sp"
        android:textStyle="bold" />
</RelativeLayout>
